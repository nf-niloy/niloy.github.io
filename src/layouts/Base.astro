---
import { profile } from '../data/profile';
import FooterClock from '../components/FooterClock.astro';
import '../styles.css';
import 'katex/dist/katex.min.css';
const { title = 'Research & Exploration', description = profile.intro } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = (p: string) => `${base}${p.replace(/^\//,'')}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f4f3ef" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} — ${profile.fullName}`} />
  <meta property="og:description" content={description} />
  <title>{title} — {profile.fullName}</title>
  <link rel="icon" href={path('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    try {
      let value = localStorage.getItem('niloy-theme');
      document.documentElement.dataset.theme = value === 'light' || value === 'dark' ? value : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch(_) {
      document.documentElement.dataset.theme = 'light';
    }
    document.documentElement.style.colorScheme = document.documentElement.dataset.theme;
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="ambient-bg" aria-hidden="true">
    <canvas id="ambient-particles"></canvas>
    <span class="ambient-orb ambient-orb-a"></span>
    <span class="ambient-orb ambient-orb-b"></span>
    <span class="ambient-orb ambient-orb-c"></span>
    <span class="ambient-mesh"></span>
  </div>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href={path('')} aria-label="Niloy — home"><span class="brand-symbol">N<span class="brand-accent">.</span></span><span class="brand-caption">NAFIZ FUAD<br />NILOY</span></a>
      <nav aria-label="Main navigation" class="desktop-nav">
        <a href={path('')} class={Astro.url.pathname === base ? 'selected' : ''}>Home</a>
        <a href={path('projects/')}>Projects</a>
        <a href={path('notes/')}>Notes</a>
        <a href={path('about/')}>About</a>
      </nav>
      <div class="header-actions">
        <button class="palette-launch" type="button" title="Search pages (Ctrl+K)" aria-label="Open command palette">⌕ <span class="palette-key">Ctrl K</span></button>
        <button class="theme-toggle" aria-label="Switch color theme" aria-pressed="false" title="Toggle light / dark mode"><span class="theme-sun">☼</span><span class="theme-moon">☾</span></button>
        <a class="header-contact" href={profile.links.linktree} target="_blank" rel="noopener noreferrer">Connect <span aria-hidden="true">↗</span></a>
        <button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="mobile-navigation" aria-expanded="false">☰</button>
      </div>
    </header>
    <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" hidden><a href={path('')}>Home</a><a href={path('projects/')}>Projects</a><a href={path('notes/')}>Notes</a><a href={path('about/')}>About</a></nav>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div><span class="footer-mark">N<span class="brand-accent">.</span></span><p>Curiosity, computation<br />& the materials around us.</p></div>
      <div class="footer-links"><a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={profile.links.linktree} target="_blank" rel="noopener noreferrer">Linktree ↗</a>{profile.links.email && <a href={`mailto:${profile.links.email}`}>Email ↗</a>}</div>
      <div class="footer-end">
        <FooterClock />
        <div class="footer-legal"><span>© {new Date().getFullYear()} {profile.name}</span><span>Built for exploration.</span></div>
      </div>
    </footer>
  </div>
  <div class="palette-overlay" hidden role="presentation">
    <section class="palette-dialog" role="dialog" aria-modal="true" aria-label="Search this website">
      <div class="palette-head"><span aria-hidden="true">⌕</span><input class="palette-input" type="search" placeholder="Search pages, projects and notes…" aria-label="Search pages"/><button class="palette-close" type="button" aria-label="Close search">ESC</button></div>
      <div class="palette-results" role="listbox"></div><div class="palette-footer">↑ ↓ Navigate &nbsp; · &nbsp; Enter Open &nbsp; · &nbsp; ESC Close</div>
    </section>
  </div>
  <script>
    import "../scripts/ambient.ts";
    const base = import.meta.env.BASE_URL;
    const metaTheme = document.querySelector('meta[name="theme-color"]');
    const themeColors = { light: '#f4f3ef', dark: '#10141c' };
    const applyThemeMeta = () => {
      const mode = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      metaTheme?.setAttribute('content', themeColors[mode]);
      document.documentElement.style.colorScheme = mode;
    };
    const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
    const updatePressed = () => button?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
    applyThemeMeta(); updatePressed();
    button?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('niloy-theme', next); } catch(_) {}
      applyThemeMeta(); updatePressed();
    });
    const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('.mobile-nav');
    // Keep the menu anchored to the viewport and synchronized with its trigger.
    // Do not modify scroll position when opening or closing it.
    const setMenuOpen = (open: boolean) => {
      if (!nav || !menu) return;
      nav.hidden = !open;
      menu.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      menu.textContent = open ? '×' : '☰';
    };
    menu?.addEventListener('click', () => setMenuOpen(nav?.hidden ?? false));
    nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenuOpen(false)));
    document.addEventListener('pointerdown', (event) => {
      if (nav?.hidden) return;
      const target = event.target as Node;
      if (!nav?.contains(target) && !menu?.contains(target)) setMenuOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && nav && !nav.hidden) {
        setMenuOpen(false);
        menu?.focus({preventScroll:true});
      }
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 1100) setMenuOpen(false);
    });
    const overlay = document.querySelector<HTMLElement>('.palette-overlay')!;
    const searchInput = document.querySelector<HTMLInputElement>('.palette-input')!;
    const results = document.querySelector<HTMLElement>('.palette-results')!;
    const launch = document.querySelector<HTMLButtonElement>('.palette-launch');
    let entries = [{title:'Home',subtitle:'Explore the homepage',url:base},{title:'Projects',subtitle:'Research and engineering work',url:base+'projects/'},{title:'Notes',subtitle:'Research notebook',url:base+'notes/'},{title:'About',subtitle:'Education and interests',url:base+'about/'}];
    const closePalette=()=>{overlay.hidden=true;searchInput.value='';launch?.focus()};
    const openPalette=()=>{overlay.hidden=false;searchInput.focus();renderPalette()};
    let active=0;
    const renderPalette=()=>{const q=searchInput.value.toLowerCase().trim();const filtered=entries.filter(e=>(e.title+' '+e.subtitle).toLowerCase().includes(q));results.replaceChildren();active=0;if(!filtered.length){const empty=document.createElement('p');empty.className='palette-empty';empty.textContent='No matching pages or notes.';results.append(empty);return}filtered.forEach((e,i)=>{const a=document.createElement('a');a.href=e.url;a.className='palette-option'+(i===0?' active':'');const span=document.createElement('span');span.textContent=e.title;const sm=document.createElement('small');sm.textContent=e.subtitle;a.append(span,sm);results.append(a)})};
    launch?.addEventListener('click',openPalette);document.querySelector('.palette-close')?.addEventListener('click',closePalette);
    overlay?.addEventListener('pointerdown',e=>{if(e.target===overlay)closePalette()});
    searchInput?.addEventListener('input',renderPalette);
    document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();overlay.hidden?openPalette():closePalette();return}if(overlay.hidden)return;if(e.key==='Escape'){closePalette();return}const items=[...results.querySelectorAll<HTMLAnchorElement>('.palette-option')];if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();active=(active+(e.key==='ArrowDown'?1:-1)+items.length)%items.length;items.forEach((a,i)=>a.classList.toggle('active',i===active));items[active]?.scrollIntoView({block:'nearest'})}if(e.key==='Enter'&&items.length){e.preventDefault();location.href=items[active].href}});
    fetch(base+'search-index.json').then(r=>r.ok?r.json():[]).then(data=>{entries=[...entries,...data];if(!overlay.hidden)renderPalette()}).catch(()=>{});
    const ob = 'IntersectionObserver' in window ? new IntersectionObserver(entries => entries.forEach(e => {if (e.isIntersecting) {e.target.classList.add('is-visible');ob.unobserve(e.target);}}), {threshold: .08}) : null;
    document.querySelectorAll('.reveal').forEach(el => ob ? ob.observe(el) : el.classList.add('is-visible'));
  </script>
</body>
</html>
