---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('notes',({data})=>!data.draft)).map(note=>({params:{slug:note.id},props:{note}}));}
const {note}=Astro.props;const {Content}=await render(note);const base=import.meta.env.BASE_URL;
---
<Base title={note.data.title} description={note.data.description}><article class="detail-page note-detail"><a class="back-link" href={`${base}notes/`}>← All notes</a><div class="detail-intro"><span class="index-label">FIELD NOTE / {note.data.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</span><h1>{note.data.title}</h1><p>{note.data.description}</p></div><div class="prose note-prose"><Content/></div></article></Base>
