---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const notes=(await getCollection('notes', ({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const base=import.meta.env.BASE_URL;
const [featured,...rest]=notes;
const filters=[...new Set(notes.flatMap(n=>n.data.tags))].sort();
const fmt=(date:Date)=>date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});
---
<Base title="Notes & Writing">
 <section class="page-top reveal"><span class="index-label">RESEARCH NOTES</span><h1>Research <em>notes.</em></h1><p>Notes on research papers, models and methods I'm learning about.</p></section>
 <section class="section page-section notes-archive"><div class="section-head"><span class="index-label">NOTES</span><span class="section-rule"></span><span class="section-aside">{String(notes.length).padStart(2,'0')} ENTRIES</span></div>
 {notes.length===0 ?
  <div class="notebook-empty reveal">
    <div class="notebook-copy"><span class="index-label">NO PUBLISHED NOTES</span><h2>Nothing <em>published yet.</em></h2><p>I'll add reading notes and technical write-ups here when they're ready to share.</p><div class="notebook-topics"><span>MATERIALS DISCOVERY</span><span>GRAPH LEARNING</span><span>SCIENTIFIC COMPUTING</span></div></div>
    <div class="notebook-art" aria-hidden="true"><span class="orbit orbit-a"></span><span class="orbit orbit-b"></span><span class="orbit orbit-c"></span><span class="orbit-center">N.</span></div>
  </div>
 : <div class="notes-collection">
   <div class="notes-search-row"><label for="notes-search-input">SEARCH THE NOTEBOOK</label><input id="notes-search-input" class="notes-search" type="search" placeholder="Search titles, keywords or ideas…" /></div>
   <div class="note-filter-row" aria-label="Filter research notes"><button class="note-filter" data-filter="all" aria-pressed="true">All topics</button>{filters.map(tag=><button class="note-filter" data-filter={tag} aria-pressed="false">{tag}</button>)}</div>
   <a href={`${base}notes/${featured.id}/`} class="featured-note note-item" data-search={`${featured.data.title} ${featured.data.description} ${featured.data.tags.join(' ')}`.toLowerCase()} data-tags={featured.data.tags.join('|')}>
     <div><span class="index-label">FEATURED NOTE / {fmt(featured.data.date)}</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><div class="tag-row">{featured.data.tags.map(tag=><span class="tag">{tag}</span>)}</div></div><span class="featured-note-arrow" aria-hidden="true">↗</span>
   </a>
   {rest.length>0 && <div class="notes-list">{rest.map(note=><a href={`${base}notes/${note.id}/`} class="note-item" data-search={`${note.data.title} ${note.data.description} ${note.data.tags.join(' ')}`.toLowerCase()} data-tags={note.data.tags.join('|')}><div><span class="index-label">{fmt(note.data.date)}</span><h2>{note.data.title}</h2><p>{note.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</div>}
   <p class="notes-no-matches" hidden>No notes match those search terms.</p>
 </div>}
 </section>
</Base>
<script>
 const input=document.querySelector<HTMLInputElement>('.notes-search');
 const buttons=[...document.querySelectorAll<HTMLButtonElement>('.note-filter')];
 let filter='all';
 function update(){let shown=0;document.querySelectorAll<HTMLElement>('.note-item').forEach(el=>{const isMatch=(el.dataset.search||'').includes(input?.value.toLowerCase()||'')&&(filter==='all'||(el.dataset.tags||'').split('|').includes(filter));el.hidden=!isMatch;if(isMatch)shown++;});const empty=document.querySelector<HTMLElement>('.notes-no-matches');if(empty)empty.hidden=shown!==0;}
 input?.addEventListener('input',update);
 buttons.forEach(btn=>btn.addEventListener('click',()=>{filter=btn.dataset.filter||'all';buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===btn)));update()}));
</script>
