---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const notes=(await getCollection('notes', ({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const base=import.meta.env.BASE_URL;
---
<Base title="Notes & Writing"><section class="page-top reveal"><span class="index-label">FIELD NOTES / 02</span><h1>Notes & <em>ideas.</em></h1><p>A space for working notes, reading reflections and scientific ideas in progress.</p></section><section class="section page-section"><div class="section-head"><span class="index-label">WRITING ARCHIVE</span><span class="section-rule"></span></div>{notes.length===0?<div class="empty-state"><span class="large-asterisk">✳</span><h2>Ideas taking shape.</h2><p>There are no published notes yet. Research notes and essays will appear here as they're added.</p></div>:<div><input class="notes-search" type="search" aria-label="Search notes" placeholder="Search title, description or keyword…"/><div class="note-filter-row" aria-label="Filter research notes"><button class="note-filter" data-filter="all" aria-pressed="true">All topics</button>{[...new Set(notes.flatMap(n=>n.data.tags))].sort().map(tag=><button class="note-filter" data-filter={tag} aria-pressed="false">{tag}</button>)}</div><div class="notes-list">{notes.map(note=><a class="note-item" data-search={`${note.data.title} ${note.data.description} ${note.data.tags.join(" ")}`.toLowerCase()} data-tags={note.data.tags.join("|")} href={`${base}notes/${note.id}/`}><div><span class="index-label">{note.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span><h2>{note.data.title}</h2><p>{note.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</div></div>}</section></Base>
<script>
const input=document.querySelector<HTMLInputElement>(".notes-search");const buttons=[...document.querySelectorAll<HTMLButtonElement>(".note-filter")];let filter="all";const update=()=>{document.querySelectorAll<HTMLElement>(".note-item").forEach(el=>{el.hidden=!(el.dataset.search||"").includes(input?.value.toLowerCase()||"")||(filter!=="all"&&!(el.dataset.tags||"").split("|").includes(filter))})};input?.addEventListener("input",update);buttons.forEach(btn=>btn.addEventListener("click",()=>{filter=btn.dataset.filter||"all";buttons.forEach(b=>b.setAttribute("aria-pressed",String(b===btn)));update()}));
</script>
