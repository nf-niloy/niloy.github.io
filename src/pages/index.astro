---
import Base from '../layouts/Base.astro';
import Graph from '../components/Graph.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||b.data.year-a.data.year);
const base = import.meta.env.BASE_URL;
const thesis = projects.find(p => p.data.type === 'Undergraduate Thesis');
const otherProjects = projects.filter(p => p.id !== thesis?.id);
---
<Base title="Research & Exploration">
  <section class="hero wide-section" aria-labelledby="hero-title">
    <div class="hero-copy reveal">
      <div class="eyebrow"><span class="eyebrow-line"></span>{profile.eyebrow}</div>
      <h1 id="hero-title">{profile.headline[0]}<br/><em>{profile.headline[1]}</em></h1>
      <p class="hero-description">I'm <strong>{profile.fullName}</strong>, an undergraduate researcher exploring the intersection of machine learning, energy systems and materials science.</p>
      <div class="hero-buttons"><a class="button button-dark" href="#work">Explore my work <span>↗</span></a><a class="text-link" href={`${base}about/`}>More about me <span>↗</span></a></div>
      <div class="hero-index"><span>BASED IN KHULNA, BANGLADESH</span><span>SCROLL TO EXPLORE ↓</span></div>
    </div>
    <Graph />
  </section>
  <section class="ticker" aria-label="Areas of interest"><div class="ticker-inner"><span>MATERIALS DISCOVERY</span><b>✳</b><span>GRAPH NEURAL NETWORKS</span><b>✳</b><span>AI FOR SCIENCE</span><b>✳</b><span>MOLECULAR ML</span><b>✳</b><span>DENSITY FUNCTIONAL THEORY</span></div></section>
  <section class="section section-intro reveal" id="about"><div class="section-head"><span class="index-label">01 / THE INTRODUCTION</span><span class="section-rule"></span></div><div class="intro-grid"><h2>Curiosity meets<br/><em>computation.</em></h2><div><p>{profile.intro}</p><p>Currently pursuing a {profile.degree} in {profile.department} at {profile.university} ({profile.universityAbbr}). My interests span data-driven materials discovery and the methods that connect atomic structure to meaningful properties.</p><a class="inline-link" href={`${base}about/`}>Read the full story <span>↗</span></a></div></div></section>
  {thesis && <section id="research" class="thesis-strip reveal" aria-labelledby="thesis-title">
    <div class="thesis-head"><span class="index-label">02 / FEATURED RESEARCH · 2026–2027</span><span class="status-pill">Ongoing</span></div>
    <h2 id="thesis-title">{thesis.data.title}</h2>
    <p class="thesis-summary">{thesis.data.summary}</p>
    <div class="tag-row">{thesis.data.tags.map(tag=><span class="tag">{tag}</span>)}</div>
    <p class="thesis-supervisor">Supervisor: {thesis.data.supervisor}</p>
  </section>}
  <section class="section work-section" id="work"><div class="section-head reveal"><span class="index-label">03 / SELECTED WORK</span><span class="section-rule"></span><span class="section-aside">PROJECT ARCHIVE — {String(otherProjects.length).padStart(2,'0')}</span></div><div class="section-title-row reveal"><h2>Made to <em>explore.</em></h2><p>A growing collection of engineering projects, experiments and research exploration.</p></div><div class="project-grid reveal">{otherProjects.map((project,i)=><ProjectCard project={project} index={i} />)}</div><a class="inline-link archive-link" href={`${base}projects/`}>Browse all projects <span>↗</span></a></section>
  <section class="section interests-section"><div class="section-head reveal"><span class="index-label">04 / RESEARCH DIRECTIONS</span><span class="section-rule"></span></div><div class="interests-grid"><div class="reveal"><h2>Thinking<br/>across <em>scales.</em></h2><p class="interest-intro">From electronic structure and molecular interactions to learned representations and materials properties.</p><div class="small-symbol" aria-hidden="true">✳</div></div><div class="interest-list">{profile.interests.map((item,i)=><div class="interest-item reveal"><span class="interest-count">{String(i+1).padStart(2,'0')}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div><span class="interest-arrow">↗</span></div>)}</div></div></section>
  <section class="section reveal" aria-label="Interactive research map">
    <div class="section-head"><span class="index-label">RESEARCH CONSTELLATION</span><span class="section-rule"></span></div>
    <div class="research-map"><div><h2>Connected by <em>curiosity.</em></h2><p class="map-caption">The questions I explore connect machine learning, atomic structure, and energy materials. Explore the constellation to see how these interests intersect.</p><p id="research-map-detail" class="map-active-detail" aria-live="polite">Select a node to explore a research direction.</p></div><div class="research-map-canvas"><svg id="research-constellation" viewBox="0 0 500 360" role="group" aria-label="Interactive map of research interests"><g id="constellation-links"></g><g id="constellation-nodes"></g></svg></div></div>
  </section>
  <section class="contact-banner reveal"><div class="eyebrow">05 / STAY CONNECTED</div><h2>Let's build <em>what's next.</em></h2><p>{profile.availability}.</p><a class="button button-light" href={profile.links.linktree} target="_blank" rel="noopener noreferrer">Get in touch <span>↗</span></a><div class="contact-decoration" aria-hidden="true">✳</div></section>
</Base>

<script>
 const canvas = document.getElementById('research-constellation') as SVGSVGElement | null;
 if(canvas){
   const labels=[['Materials Discovery','Computational search for useful energy materials.'],['Graph Neural Networks','Learning from atomic structure and connectivity.'],['AI for Science','Bringing machine learning into scientific workflows.'],['Molecular ML','Structure-aware models for molecular systems.'],['DFT','First-principles electronic-structure calculations.']];
   const nodes=[[245,65],[390,165],[330,290],[135,285],[95,155]];
   const ns='http://www.w3.org/2000/svg';let pointer={x:250,y:180,active:false};
   const links=document.getElementById('constellation-links')!,layer=document.getElementById('constellation-nodes')!;
   const lines=nodes.map((_,i)=>{const line=document.createElementNS(ns,'line');line.setAttribute('class','map-link');links.append(line);return line;});
   const groups=labels.map(([label,desc],i)=>{const group=document.createElementNS(ns,'g');group.setAttribute('class','map-node');group.setAttribute('tabindex','0');group.setAttribute('role','button');group.setAttribute('aria-label',label);const circle=document.createElementNS(ns,'circle');circle.setAttribute('r',label.length>18?'60':'52');const text=document.createElementNS(ns,'text');text.setAttribute('text-anchor','middle');label.split(' ').reduce((rows,word)=>{if(!rows.length || rows[rows.length-1].join(' ').length+word.length>16)rows.push([]);rows[rows.length-1].push(word);return rows;},[] as string[][]).forEach((words,j,arr)=>{const t=document.createElementNS(ns,'tspan');t.setAttribute('x','0');t.setAttribute('dy',j===0?String((1-arr.length)*7):'14');t.textContent=words.join(' ');text.append(t)});group.append(circle,text);layer.append(group);const select=()=>{groups.forEach(g=>g.classList.remove('active'));group.classList.add('active');const detail=document.getElementById('research-map-detail');if(detail)detail.textContent=desc};group.addEventListener('click',select);group.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select()}});return group});
   let frame=0,visible=true;const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
   const render=(time:number)=>{const positions=nodes.map(([x,y],i)=>{const dx=pointer.x-x,dy=pointer.y-y,d=Math.hypot(dx,dy);const push=pointer.active&&d<110?(110-d)*.12:0;return [x+(reduced?0:Math.sin(time/1650+i)*4)-(dx/(d||1))*push,y+(reduced?0:Math.cos(time/1780+i*2)*4)-(dy/(d||1))*push]});positions.forEach(([x,y],i)=>{groups[i].setAttribute('transform',`translate(${x} ${y})`);lines[i].setAttribute('x1',String(x));lines[i].setAttribute('y1',String(y));lines[i].setAttribute('x2',String(positions[(i+1)%nodes.length][0]));lines[i].setAttribute('y2',String(positions[(i+1)%nodes.length][1]))});if(!reduced&&visible)frame=requestAnimationFrame(render)};
   canvas.addEventListener('pointermove',e=>{const rect=canvas.getBoundingClientRect();pointer={x:(e.clientX-rect.left)/rect.width*500,y:(e.clientY-rect.top)/rect.height*360,active:true}});canvas.addEventListener('pointerleave',()=>pointer.active=false);
   if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(visible&&!reduced)frame=requestAnimationFrame(render);else cancelAnimationFrame(frame)});observer.observe(canvas)}
   render(0);
 }
</script>
