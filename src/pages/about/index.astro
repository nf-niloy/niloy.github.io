---
import Base from '../../layouts/Base.astro';
import {profile} from '../../data/profile';
---
<Base title="About"><section class="page-top reveal"><span class="index-label">ABOUT ME / 03</span><h1>Hi, I'm <em>{profile.name}.</em></h1><p>{profile.intro}</p></section><section class="section about-section"><div class="section-head"><span class="index-label">01 / BACKGROUND</span><span class="section-rule"></span></div><div class="about-grid"><h2>Engineering roots.<br/><em>Computational curiosity.</em></h2><div><p>I am {profile.fullName}, a {profile.year} {profile.degree} student in {profile.department} at {profile.university}.</p><p>My interests sit at the intersection of engineering, machine learning and scientific computation. I am particularly interested in how graph-based learning and atomistic modeling can contribute to energy-materials discovery.</p><div class="facts"><div><span>EDUCATION</span><strong>{profile.degree}</strong></div><div><span>DEPARTMENT</span><strong>{profile.department}</strong></div><div><span>INSTITUTION</span><strong>{profile.universityAbbr}</strong></div><div><span>LOCATION</span><strong>{profile.location}</strong></div></div></div></div></section><section class="section about-section"><div class="section-head"><span class="index-label">02 / INTERESTS</span><span class="section-rule"></span></div><div class="about-grid"><h2>Questions I'm<br/><em>drawn to.</em></h2><div class="interest-list">{profile.interests.map((item,i)=><div class="interest-item"><span class="interest-count">{String(i+1).padStart(2,'0')}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div></div>)}</div></div></section><section class="contact-banner"><div class="eyebrow">LET'S CONNECT</div><h2>Open to <em>ideas.</em></h2><p>{profile.availability}.</p><a class="button button-light" href={profile.links.linktree} target="_blank" rel="noopener noreferrer">Find me online <span>↗</span></a></section></Base>
