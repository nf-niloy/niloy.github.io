---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const base = import.meta.env.BASE_URL;
const isThesis = project.data.type === 'Undergraduate Thesis';
const isWebApp = Boolean(project.data.demo);
const hasThemeImages = Boolean(project.data.imageLight && project.data.imageDark);
---
<Base title={project.data.shortTitle || project.data.title} description={project.data.summary}>
  <article class="detail-page case-study">
    <a class="back-link" href={`${base}projects/`}>← All projects</a>
    <header class="case-hero">
      <div class="case-kicker">
        <span class="index-label">{isThesis ? 'ONGOING RESEARCH' : 'SELECTED ENGINEERING WORK'} / {project.data.year}</span>
        <span class="case-status">{project.data.status}</span>
      </div>
      <h1>{project.data.title}</h1>
      <p class="case-lead">{project.data.summary}</p>
      <div class="tag-row">{project.data.tags.map(tag => <span class="tag">{tag}</span>)}</div>
      {project.data.supervisor && <p class="case-supervisor">Supervisor: {project.data.supervisor}</p>}
    </header>

    {(hasThemeImages || project.data.image) && (
      <section class="case-visual" aria-label={isThesis ? 'Conceptual research illustration' : isWebApp ? 'Web application screenshots' : 'Project photograph'}>
        {hasThemeImages ? (
          <>
            <a class="theme-link theme-link--light"
               href={project.data.imageLight}
               target="_blank" rel="noopener noreferrer"
               title="Open light illustration at full resolution">
              <img src={project.data.imageLight}
                   alt={`${isWebApp ? 'Web interface screenshot' : 'Conceptual illustration'} for ${project.data.shortTitle || project.data.title} (light version)`}
                   loading="eager" />
              <span class="case-visual-action">VIEW ORIGINAL ↗</span>
            </a>
            <a class="theme-link theme-link--dark"
               href={project.data.imageDark}
               target="_blank" rel="noopener noreferrer"
               title="Open dark illustration at full resolution">
              <img src={project.data.imageDark}
                   alt={`${isWebApp ? 'Web interface screenshot' : 'Conceptual illustration'} for ${project.data.shortTitle || project.data.title} (dark version)`}
                   loading="eager" />
              <span class="case-visual-action">VIEW ORIGINAL ↗</span>
            </a>
          </>
        ) : (
          <a href={project.data.image} target="_blank" rel="noopener noreferrer" title="Open full-resolution photograph">
            <img src={project.data.image}
                 alt={`Physical setup photograph for ${project.data.shortTitle || project.data.title}`}
                 loading="eager" />
            <span class="case-visual-action">VIEW ORIGINAL ↗</span>
          </a>
        )}
        <p>{isThesis ? '01 / CONCEPTUAL ILLUSTRATION — NOT A SIMULATION RESULT' : isWebApp ? '01 / AUTOLAB SCADA — WEB INTERFACE PREVIEW' : '01 / PROJECT DOCUMENTATION — PHYSICAL SETUP'}</p>
      </section>
    )}

    <div class="case-overview">
      <aside class="case-sidebar" aria-label="Project information">
        <div class="case-fact"><span>STATUS</span><p>{project.data.status}</p></div>
        <div class="case-fact"><span>YEAR</span><p>{project.data.year}</p></div>
        <div class="case-fact"><span>CATEGORY</span><p>{project.data.type}</p></div>
        {!isThesis && (project.data.github || project.data.report || project.data.demo) && (
          <div class="case-actions">
            <span class="index-label">PROJECT RESOURCES</span>
            {project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer">Try live web app <span>↗</span></a>}
            {project.data.github && <a href={project.data.github} target="_blank" rel="noopener noreferrer">Source repository <span>↗</span></a>}
            {project.data.report && <a href={project.data.report} target="_blank" rel="noopener noreferrer">Technical report (PDF) <span>↗</span></a>}
          </div>
        )}
      </aside>
      <div class="case-body">
        {headings.length > 0 && (
          <nav class="case-outline" aria-label="On this page">
            <span class="index-label">IN THIS CASE STUDY</span>
            {headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text} ↗</a>)}
          </nav>
        )}
        <div class="prose"><Content /></div>
      </div>
    </div>
    {project.data.github && !isThesis && (
      <div class="case-endnote">
        <div><span class="index-label">EXPLORE THE IMPLEMENTATION</span><h2>From idea to <em>working system.</em></h2></div>
        {project.data.demo && <a class="button button-dark" href={project.data.demo} target="_blank" rel="noopener noreferrer">Try live web app ↗</a>}
        <a class={project.data.demo ? 'button button-light' : 'button button-dark'} href={project.data.github} target="_blank" rel="noopener noreferrer">View project on GitHub ↗</a>
      </div>
    )}
  </article>
</Base>

<style>
  /* Both the displayed illustration and its 'View Original' link follow the site theme. */
  .case-visual a.theme-link--dark { display: none; }
  :global(html[data-theme='dark']) .case-visual a.theme-link--light { display: none; }
  :global(html[data-theme='dark']) .case-visual a.theme-link--dark { display: block; }
</style>
