---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
// Curated archive order (independent of project completion year).
const projectRank: Record<string, number> = {
  'autolab-scada': 1,
  'glazing-energy-analysis': 2,
  'battery-thermal-management': 3,
};
const projects = (await getCollection('projects')).sort((a, b) => {
  const aRank = a.data.type === 'Undergraduate Thesis' ? 0 : (projectRank[a.id] ?? 4);
  const bRank = b.data.type === 'Undergraduate Thesis' ? 0 : (projectRank[b.id] ?? 4);
  return aRank - bRank || b.data.year - a.data.year;
});
---
<Base title="Projects"><section class="page-top reveal"><span class="index-label">PROJECT ARCHIVE / 01</span><h1>Selected <em>projects.</em></h1><p>Engineering projects and research work.</p></section><section class="section page-section"><div class="section-head"><span class="index-label">ALL PROJECTS ({projects.length})</span><span class="section-rule"></span></div><div class="project-grid">{projects.map((project,i)=><ProjectCard project={project} index={i}/>)}</div></section></Base>
